{
  "name": "k8s-readonly-mcp",
  "version": "1.0.0",
  "description": "Read-only Kubernetes MCP server for AI agents (Claude Code, Cursor, Gemini CLI, Codex CLI, VS Code Copilot). It has no write tools, and Kubernetes RBAC enforces read-only access as a second wall.",
